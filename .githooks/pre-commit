#!/bin/sh
# main(또는 master) 브랜치에 직접 커밋하는 것을 막습니다.
branch=$(git rev-parse --abbrev-ref HEAD 2>/dev/null)

if [ "$branch" = "main" ] || [ "$branch" = "master" ]; then
  echo ""
  echo "=================================================="
  echo " [커밋 차단] main 브랜치에는 직접 커밋할 수 없습니다."
  echo ""
  echo " 개별 브랜치를 만들어서 작업해 주세요:"
  echo "   git switch -c feature/작업이름"
  echo ""
  echo " 지금까지 바꾼 내용은 새 브랜치로 그대로 따라갑니다."
  echo "=================================================="
  echo ""
  exit 1
fi

exit 0
